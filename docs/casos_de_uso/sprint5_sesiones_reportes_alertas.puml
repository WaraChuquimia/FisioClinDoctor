@startuml Sprint5_Sesiones_Reportes_Alertas
!theme plain
left to right direction
skinparam packageStyle rectangle
skinparam usecaseFontSize 12
skinparam wrapWidth 160

rectangle {
  actor "Médico Fisiatra" as Medico
  actor "Administrador" as Super
  usecase "Gestionar agenda\ny reportes" as H1
  Medico -- H1
  Super  -- H1

  actor "Paciente" as Paciente
  usecase "Gestionar mensajería\ny alertas" as H2
  Medico   -- H2
  Super    -- H2
  Paciente -- H2

  usecase "Programar cita" as C1
  usecase "Reprogramar cita" as C2
  usecase "Cerrar cita" as C3
  usecase "Reporte de\npaciente" as C4
  usecase "Reporte de\nadherencia" as C5
  usecase "Exportar reporte\na PDF" as C6
  usecase "Enviar mensaje" as C7
  usecase "Recibir alerta\nautomática" as C8

  H1 <.. C1 : <<extend>>
  H1 <.. C2 : <<extend>>
  H1 <.. C3 : <<extend>>
  H1 <.. C4 : <<extend>>
  H1 <.. C5 : <<extend>>
  H1 <.. C6 : <<extend>>

  H2 ..> C7 : <<include>>
  H2 <.. C8 : <<extend>>
}

@enduml
