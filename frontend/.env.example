# =============================================================================
# Copia este archivo y renómbralo a  .env  (sin el .example)
# Los dos valores salen de: Supabase -> Project Settings -> API
# =============================================================================

# "Project URL"
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# "anon public"  (la larga que empieza con eyJ...)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# NUNCA pongas aquí la "service_role". Esa da acceso total y salta
# toda la seguridad. Solo va en un servidor, nunca en el navegador.

# =============================================================================
# Servidor de envío de OTP (backend/otp/) — ver backend/otp/.env.example
# =============================================================================

# URL del endpoint que envía el correo con el código OTP
VITE_OTP_URL=http://localhost:3001/api/enviar-otp

# Debe ser idéntico a OTP_SHARED_SECRET en backend/otp/.env
VITE_OTP_SHARED_SECRET=
