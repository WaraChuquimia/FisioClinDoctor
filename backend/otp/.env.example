# =============================================================================
# Copia este archivo y renómbralo a  .env  (sin el .example)
# =============================================================================

PORT=3001

# Cuenta de Gmail que envía los correos con el código OTP.
# GMAIL_APP_PASS es una "contraseña de aplicación" de Gmail (no tu contraseña normal):
# https://myaccount.google.com/apppasswords
GMAIL_USER=tu-correo@gmail.com
GMAIL_APP_PASS=xxxx xxxx xxxx xxxx

# Orígenes permitidos a llamar este servidor (coma-separados)
OTP_ALLOWED_ORIGINS=http://localhost:5173

# Clave compartida con el frontend — debe ser igual a VITE_OTP_SHARED_SECRET
# en el .env de la raíz del proyecto. Genera una con:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
OTP_SHARED_SECRET=
